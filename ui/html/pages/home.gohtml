{{template "base" .}}

{{define "content" }}
<div class="split">

	<section class="pane pane-input">
		<a href="/" class="brand">
			<svg width="32" height="32" viewBox="0 0 30 30" aria-hidden="true"><rect width="30" height="30" rx="8" fill="#FFD60A"/><path d="M10 8v14h10" stroke="#2438E8" stroke-width="3.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
			Lynkr
		</a>

		<div class="hero">
			<h1>Paste it. Shrink it. Share it.</h1>
			<p>Long links go in. Short ones come out, with a click count.</p>
			<form id="shorten-form" class="shorten-form">
				<label for="long-url-input" class="sr-only">Link to shorten</label>
				<input
					id="long-url-input"
					type="url"
					required
					placeholder="https://your-long-url.com/..."
					title="Must be a valid URL" />
				<label for="title-input" class="sr-only">Title (optional)</label>
				<input
					id="title-input"
					type="text"
					maxlength="120"
					placeholder="Title (optional)" />
				<button type="submit" class="btn-primary">Shorten this link</button>
			</form>
			<p id="shorten-error" class="error" role="alert" hidden></p>
		</div>

		<div class="pane-foot">
			Open source, written in Go.
			<a href="https://github.com/vilas-gannaram/Lynkr" target="_blank" rel="noopener noreferrer">View on GitHub</a>
		</div>
	</section>

	<section class="pane pane-output">

		<div id="shorten-result" class="result" hidden>
			<div class="label">Your new link</div>
			<div id="short-url-display" class="result-url"></div>
			<div id="result-meta" class="meta"></div>
			<div class="result-actions">
				<button id="copy-btn" type="button" class="btn-solid">Copy link</button>
				<a id="open-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-outline">Open</a>
			</div>
		</div>

		<div class="links">
			<div class="links-head">
				<h2>Your links</h2>
				<span id="links-summary" class="meta"></span>
			</div>

			<div class="card">
				<table>
					<colgroup><col class="c-short"><col><col class="c-clicks"><col class="c-actions"></colgroup>
					<thead>
						<tr>
							<th scope="col">Short link</th>
							<th scope="col">Destination</th>
							<th scope="col" class="num">Clicks</th>
							<th scope="col"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody id="links-body">
						{{range .}}
						<tr data-code="{{.Code}}" data-clicks="{{.ClickCount}}">
							<td class="code"><a href="/{{.Code}}" target="_blank" rel="noopener noreferrer">/{{.Code}}</a></td>
							<td class="dest">
								{{if .Title.Valid}}<div class="dest-title">{{.Title.String}}</div>{{end}}
								<div class="dest-url" title="{{.TargetUrl}}">{{.TargetUrl}}</div>
								<div class="meta-sm">{{.CreatedAt.Time.Format "Jan 2"}}</div>
							</td>
							<td class="num strong">{{.ClickCount}}</td>
							<td class="act">
								<button type="button" class="btn-small btn-danger" data-delete="{{.Code}}" aria-label="Delete /{{.Code}}">Delete</button>
							</td>
						</tr>
						{{end}}
					</tbody>
				</table>
				<p id="links-empty" class="empty"{{if .}} hidden{{end}}>No links yet. Shorten your first one.</p>
			</div>

			<nav id="pager" class="pager" aria-label="Pagination" data-count="{{len .}}" hidden>
				<a id="pager-prev" href="#" class="btn-outline" hidden>&larr; Newer</a>
				<span id="pager-page" class="meta"></span>
				<a id="pager-next" href="#" class="btn-outline" hidden>Older &rarr;</a>
			</nav>
		</div>
	</section>

</div>
{{end}}
