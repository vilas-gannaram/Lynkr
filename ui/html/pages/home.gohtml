{{template "base" .}}

{{define "content" }}
  <div class="flex-1 relative">
		<header class="navbar shadow-sm px-4 md:px-10 sticky top-0 w-full bg-base-100 text-base-content z-20">
			<div class="flex gap-x-2">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
					fill-rule="evenodd"
					clip-rule="evenodd"
					class="fill-current">
					<path
					d="M22.672 15.226l-2.432.811.841 2.515c.33 1.019-.209 2.127-1.23 2.456-1.15.325-2.148-.321-2.463-1.226l-.84-2.518-5.013 1.677.84 2.517c.391 1.203-.434 2.542-1.831 2.542-.88 0-1.601-.564-1.86-1.314l-.842-2.516-2.431.809c-1.135.328-2.145-.317-2.463-1.229-.329-1.018.211-2.127 1.231-2.456l2.432-.809-1.621-4.823-2.432.808c-1.355.384-2.558-.59-2.558-1.839 0-.817.509-1.582 1.327-1.846l2.433-.809-.842-2.515c-.33-1.02.211-2.129 1.232-2.458 1.02-.329 2.13.209 2.461 1.229l.842 2.515 5.011-1.677-.839-2.517c-.403-1.238.484-2.553 1.843-2.553.819 0 1.585.509 1.85 1.326l.841 2.517 2.431-.81c1.02-.33 2.131.211 2.461 1.229.332 1.018-.21 2.126-1.23 2.456l-2.433.809 1.622 4.823 2.433-.809c1.242-.401 2.557.484 2.557 1.838 0 .819-.51 1.583-1.328 1.847m-8.992-6.428l-5.01 1.675 1.619 4.828 5.011-1.674-1.62-4.829z"></path>
				</svg>
				<a href="/" class="link link-hover text-xl">Lynkr.io</a>
			</div>
		</header>

  	{{/* Hero Section */}}
	<div class="hero mb-16 md:mb-22 py-16 md:pt-22 sticky top-16 w-full bg-base-100 text-base-content z-10">
		<div class="hero-content text-center w-full">
			<div class="w-full max-w-3xl">
				<h1 class="text-5xl font-bold">
					Your URL called. It wants a diet.
				</h1>
				<p class="mt-1 text-base-content/70 text-xl">
					Paste it long, get it back short. No gym membership required.
				</p>

				{{/* InputForm */}}
				<form id="shorten-form" class="flex flex-col sm:flex-row gap-2 justify-center mt-3 w-full">
					<label class="input validator w-full sm:w-auto sm:flex-1">
						<svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
							<g
							stroke-linejoin="round"
							stroke-linecap="round"
							stroke-width="2.5"
							fill="none"
							stroke="currentColor"
							>
							<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
							<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</g>
						</svg>
						<input 
							id="long-url-input"
							class="w-full"
							type="url"
							required
							placeholder="https://your-long-url.com/..."
							pattern="^(https?://)?([a-zA-Z0-9]([a-zA-Z0-9\-].*[a-zA-Z0-9])?\.)+[a-zA-Z].*$"
							title="Must be valid URL"
						/>
					</label>

					<button type="submit" class="btn btn-neutral">Shorten</button>
				</form>
				<p class="validator-hint text-left mt-1">Must be a valid URL</p>

				{{/* Result */}}
				<div id="shorten-result" class="hidden mt-4 flex flex-col sm:flex-row gap-2 justify-center">
					<label class="input w-full sm:w-auto sm:flex-1">
						<input id="short-url-output" type="text" readonly />
					</label>
					<button id="copy-btn" type="button" class="btn btn-outline">Copy</button>
				</div>

				<p id="shorten-error" class="text-error hidden mt-2"></p>
			</div>
		</div>
	</div>


	<div class="max-w-4xl mx-auto px-4 pb-16 mt-16">
		{{if .}}
			<div class="overflow-x-auto">
				<table class="table table-zebra">
					<thead>
						<tr>
							<th>#</th>
							<th>Short URL</th>
							<th>Original URL</th>
							<th>Clicks</th>
							<th>Created</th>
						</tr>
					</thead>
					<tbody>
						{{range $i, $url := .}}
						<tr>
							<th>{{inc $i}}</th>
							<td><a class="link link-info" href="/{{$url.ShortCode}}" target="_blank">/{{$url.ShortCode}}</a></td>
							<td class="max-w-xs truncate text-xs" title="{{$url.OriginalUrl}}">{{$url.OriginalUrl}}</td>
							<td>{{$url.ClickCount}}</td>
							<td>{{$url.CreatedAt.Time.Format "Jan 2, 2006"}}</td>
						</tr>
						{{end}}
					</tbody>
				</table>
			</div>
		{{else}}
			<p class="text-center text-base-content/60">No URLs shortened yet — try the form above.</p>
		{{end}}
	</div>
  </div>
{{end}}